# === Enable Banking (único proveedor Open Banking soportado) ===
# Registra una app en https://enablebanking.com (Control Panel):
#   - genera la clave en el navegador y DESCÁRGALA (solo se muestra una vez)
#   - redirect URL (exige HTTPS): https://localhost:3000/callback
#   - en la app, "Link accounts" para vincular tus cuentas (Restricted Production)
ENABLEBANKING_APP_ID=
# Clave privada: por defecto data/enablebanking_private.pem (descomenta para otra ruta)
# ENABLEBANKING_KEY_PATH=/ruta/absoluta/a/enablebanking_private.pem
ENABLEBANKING_REDIRECT_URI=https://localhost:3000/callback

# === Un solo banco (modo simple) ===
# Nombre EXACTO del banco (lista con: finmcp institutions). Para CaixaBank: "CaixaBank".
# Ignorado si defines FINMCP_BANK_1_* más abajo (modo multi-banco).
ENABLEBANKING_ASPSP_NAME=
ENABLEBANKING_COUNTRY=ES

# === Varios bancos (modo multi-banco) ===
# Descomenta y numera consecutivamente (FINMCP_BANK_1_*, FINMCP_BANK_2_*, ...).
# Si defines al menos un FINMCP_BANK_N_*, se ignoran ENABLEBANKING_ASPSP_NAME/COUNTRY.
# FINMCP_BANK_1_ID=caixa
# FINMCP_BANK_1_ASPSP_NAME=CaixaBank
# FINMCP_BANK_1_COUNTRY=ES
# FINMCP_BANK_2_ID=bbva
# FINMCP_BANK_2_ASPSP_NAME=BBVA
# FINMCP_BANK_2_COUNTRY=ES

# === Bonusly (puntos de reconocimiento como si fueran una cuenta; solo lectura) ===
# Token personal (PAT): Bonusly → Settings → API → Create token, con SOLO los scopes
# user:read, recognition:read y rewards:read. Caduca (máx. 365 días): renuévelo con el aviso.
# Con el token, `finmcp sync` incluye el banco "Bonusly": ingresos = reconocimientos recibidos,
# gastos = canjes (comercio = marca de la tarjeta regalo); saldo = puntos × BONUSLY_EUR_PER_POINT.
# Vacío = sin Bonusly. El valor del punto, con 2 decimales como máximo (importes exactos en céntimos).
# BONUSLY_API_TOKEN=
# BONUSLY_EUR_PER_POINT=1.08
# BONUSLY_BANK_ID=Bonusly

# === Almacenamiento ===
# Por defecto: SQLite en <repo>/data/finmcp.db. Descomenta para cambiar la ruta.
# FINMCP_DB_PATH=/ruta/absoluta/a/openbanking-mcp/data/finmcp.db

# === Cifrado de tokens/sesión en reposo ===
# Clave Fernet. Si la dejas vacía, se genera una y se guarda en data/fernet.key (chmod 600).
# Generar una manualmente:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINMCP_ENCRYPTION_KEY=

# Puerto del callback local del flujo de autorización
FINMCP_CALLBACK_PORT=3000

# === Servidor MCP por HTTP (solo si usas `finmcp serve --http`, p.ej. ChatGPT) ===
# Token bearer exigido en cada petición. Déjalo vacío para stdio (Claude Desktop).
# FINMCP_HTTP_TOKEN=

# === Panel web (`finmcp web`) ===
# Huella del PIN del panel. No la escribas a mano: usa `finmcp web-pin`, que la genera
# (nunca se guarda el PIN). Vacío = panel sin PIN, abierto a toda la red local.
# FINMCP_WEB_PIN_HASH=
# Segundos mínimos entre dos sincronizaciones lanzadas desde el panel (tirar hacia abajo). Cuenta desde
# la última de cualquier origen (cron, CLI o panel). 0 = sin freno; no se recomienda: PSD2 limita los accesos
# de cada banco y un tirón repetido podría agotar el cupo del sync diario.
# FINMCP_WEB_SYNC_COOLDOWN=300
